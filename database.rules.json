{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.child('host').val() === auth.uid || (data.exists() && !newData.exists() && (data.child('host').val() === auth.uid || !data.child('players').exists())))",
        "host": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid || (!data.parent().child('players').child(data.val()).exists() && data.parent().child('players').child(newData.val()).exists()))"
        },
        "status": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "countdownEndsAt": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "finishedAt": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "text": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "duration": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "mode": {
          ".write": "auth != null && (!data.exists() || data.parent().child('host').val() === auth.uid)"
        },
        "maxPlayers": {
          ".write": "auth != null && (!data.exists() || data.parent().child('host').val() === auth.uid)"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.parent().child('host').val() === auth.uid || (newData.child(auth.uid).exists() && data.parent().child('status').val() === 'waiting'))",
          ".validate": "!data.parent().child('maxPlayers').exists() || newData.numChildren() <= data.parent().child('maxPlayers').val()",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'progress', 'wpm', 'accuracy', 'isFinished'])",
            "wpm": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 350"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "progress": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "isFinished": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "typing": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "chat": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
